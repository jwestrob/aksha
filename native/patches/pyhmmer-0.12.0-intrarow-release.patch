+static void intrarow_release_omx(P7_OMX *ox, int release_dp, int release_x);
+
+static uint64_t intrarow_release_min_bytes = 0;
+static size_t intrarow_release_page_size = 0;
+static uint64_t intrarow_release_calls = 0;
+static uint64_t intrarow_release_bytes = 0;
+
+int
+p7_pipeline_IntraRowPageReleaseConfigure(uint64_t min_allocation_bytes)
+{
+#if defined(__linux__) && defined(eslENABLE_SSE)
+  long observed_page_size;
+
+  if (min_allocation_bytes == 0)
+    {
+      __atomic_store_n(&intrarow_release_min_bytes, 0, __ATOMIC_RELEASE);
+      return eslOK;
+    }
+  observed_page_size = sysconf(_SC_PAGESIZE);
+  if (observed_page_size <= 0) return eslFAIL;
+  __atomic_store_n(&intrarow_release_page_size,
+                   (size_t) observed_page_size, __ATOMIC_RELAXED);
+  __atomic_store_n(&intrarow_release_min_bytes, min_allocation_bytes,
+                   __ATOMIC_RELEASE);
+  return eslOK;
+#else
+  return min_allocation_bytes == 0 ? eslOK : eslENOTSUP;
+#endif
+}
+
+void
+p7_pipeline_IntraRowPageReleaseResetStatistics(void)
+{
+  __atomic_store_n(&intrarow_release_calls, 0, __ATOMIC_RELAXED);
+  __atomic_store_n(&intrarow_release_bytes, 0, __ATOMIC_RELAXED);
+}
+
+void
+p7_pipeline_IntraRowPageReleaseStatistics(uint64_t *ret_calls,
+                                          uint64_t *ret_bytes)
+{
+  if (ret_calls != NULL)
+    *ret_calls = __atomic_load_n(&intrarow_release_calls, __ATOMIC_RELAXED);
+  if (ret_bytes != NULL)
+    *ret_bytes = __atomic_load_n(&intrarow_release_bytes, __ATOMIC_RELAXED);
+}
+
+static void
+intrarow_release_pages(void *touched, uint64_t touched_bytes, size_t page_size)
+{
+#if defined(__linux__)
+  uintptr_t start;
+  uintptr_t first;
+  uintptr_t end;
+  size_t advised_bytes;
+
+  if (touched == NULL || touched_bytes < page_size) return;
+  start = (uintptr_t) touched;
+  first = ((start + page_size - 1) / page_size) * page_size;
+  end = ((start + touched_bytes) / page_size) * page_size;
+  if (end <= first) return;
+  advised_bytes = (size_t) (end - first);
+  if (madvise((void *) first, advised_bytes, MADV_DONTNEED) != 0) return;
+  __atomic_fetch_add(&intrarow_release_calls, 1, __ATOMIC_RELAXED);
+  __atomic_fetch_add(&intrarow_release_bytes, advised_bytes, __ATOMIC_RELAXED);
+#else
+  (void) touched;
+  (void) touched_bytes;
+  (void) page_size;
+#endif
+}
+
+static void
+intrarow_release_omx(P7_OMX *ox, int release_dp, int release_x)
+{
+#if defined(__linux__) && defined(eslENABLE_SSE)
+  uint64_t min_allocation_bytes;
+  uint64_t logical_bytes;
+  uint64_t logical_row_bytes;
+  uint64_t row_count;
+  uint64_t retained_row_bytes;
+  size_t page_size;
+  int row;
+
+  min_allocation_bytes = __atomic_load_n(&intrarow_release_min_bytes,
+                                         __ATOMIC_ACQUIRE);
+  if (min_allocation_bytes == 0 || ox == NULL || ox->M <= 0 || ox->L < 0)
+    return;
+  page_size = __atomic_load_n(&intrarow_release_page_size, __ATOMIC_RELAXED);
+  if (page_size == 0) return;
+  row_count = (uint64_t) ox->L + 1;
+  if (release_dp)
+    {
+      logical_row_bytes = (uint64_t) p7O_NQF(ox->M) * sizeof(__m128) *
+                          p7X_NSCELLS;
+      retained_row_bytes = (uint64_t) ox->allocQ4 * sizeof(__m128) *
+                           p7X_NSCELLS;
+      if (row_count <= (uint64_t) ox->validR &&
+          logical_row_bytes <= retained_row_bytes &&
+          logical_row_bytes <= UINT64_MAX / row_count)
+        {
+          logical_bytes = logical_row_bytes * row_count;
+          if (logical_bytes >= min_allocation_bytes)
+            {
+              if (logical_row_bytes == retained_row_bytes)
+                intrarow_release_pages(ox->dpf[0], logical_bytes, page_size);
+              else if (logical_row_bytes >= page_size)
+                for (row = 0; row <= ox->L; row++)
+                  intrarow_release_pages(ox->dpf[row], logical_row_bytes,
+                                         page_size);
+            }
+        }
+    }
+  if (release_x)
+    {
+      logical_row_bytes = sizeof(float) * p7X_NXCELLS;
+      if (row_count <= (uint64_t) ox->allocXR &&
+          logical_row_bytes <= UINT64_MAX / row_count)
+        {
+          logical_bytes = logical_row_bytes * row_count;
+          if (logical_bytes >= min_allocation_bytes)
+            intrarow_release_pages(ox->xmx, logical_bytes, page_size);
+        }
+    }
+#else
+  (void) ox;
+  (void) release_dp;
+  (void) release_x;
+#endif
+}
 
 
