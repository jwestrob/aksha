+static int
+pipeline_compact_tail_options_are_valid(const P7_PIPELINE *pli)
+{
+  if (pli == NULL || pli->ddef == NULL ||
+      ! isfinite(pli->F1) || pli->F1 < 0.0 || pli->F1 > 1.0 ||
+      ! isfinite(pli->F2) || pli->F2 < 0.0 || pli->F2 > 1.0 ||
+      ! isfinite(pli->F3) || pli->F3 < 0.0 || pli->F3 > 1.0 ||
+      ! isfinite(pli->E) || pli->E < 0.0 ||
+      ! isfinite(pli->domE) || pli->domE < 0.0 ||
+      ! isfinite(pli->incE) || pli->incE < 0.0 ||
+      ! isfinite(pli->incdomE) || pli->incdomE < 0.0 ||
+      ! isfinite(pli->T) || ! isfinite(pli->domT) ||
+      ! isfinite(pli->incT) || ! isfinite(pli->incdomT) ||
+      ! isfinite(pli->Z) || pli->Z < 0.0 ||
+      ! isfinite(pli->domZ) || pli->domZ < 0.0 ||
+      ! isfinite(pli->ddef->rt1) || pli->ddef->rt1 < 0.0f || pli->ddef->rt1 > 1.0f ||
+      ! isfinite(pli->ddef->rt2) || pli->ddef->rt2 < 0.0f || pli->ddef->rt2 > 1.0f ||
+      ! isfinite(pli->ddef->rt3) || pli->ddef->rt3 < 0.0f || pli->ddef->rt3 > 1.0f ||
+      pli->ddef->nsamples <= 0 ||
+      ! isfinite(pli->ddef->min_overlap) || pli->ddef->min_overlap < 0.0f ||
+      pli->ddef->min_overlap > 1.0f || pli->ddef->max_diagdiff < 0 ||
+      ! isfinite(pli->ddef->min_posterior) || pli->ddef->min_posterior < 0.0f ||
+      pli->ddef->min_posterior > 1.0f ||
+      ! isfinite(pli->ddef->min_endpointp) || pli->ddef->min_endpointp < 0.0f ||
+      pli->ddef->min_endpointp > 1.0f)
+    return FALSE;
+  if ((pli->do_biasfilter != FALSE && pli->do_biasfilter != TRUE) ||
+      (pli->do_null2 != FALSE && pli->do_null2 != TRUE) ||
+      (pli->do_reseeding != FALSE && pli->do_reseeding != TRUE) ||
+      (pli->do_max != FALSE && pli->do_max != TRUE) ||
+      (pli->do_alignment_score_calc != FALSE && pli->do_alignment_score_calc != TRUE) ||
+      (pli->by_E != FALSE && pli->by_E != TRUE) ||
+      (pli->dom_by_E != FALSE && pli->dom_by_E != TRUE) ||
+      (pli->inc_by_E != FALSE && pli->inc_by_E != TRUE) ||
+      (pli->incdom_by_E != FALSE && pli->incdom_by_E != TRUE) ||
+      (pli->ddef->of_smaller != FALSE && pli->ddef->of_smaller != TRUE) ||
+      (pli->ddef->do_reseeding != FALSE && pli->ddef->do_reseeding != TRUE) ||
+      (pli->show_accessions != FALSE && pli->show_accessions != TRUE) ||
+      (pli->show_alignments != FALSE && pli->show_alignments != TRUE) ||
+      (pli->use_bit_cutoffs != FALSE && pli->use_bit_cutoffs != p7H_GA &&
+       pli->use_bit_cutoffs != p7H_TC && pli->use_bit_cutoffs != p7H_NC) ||
+      pli->Z_setby < p7_ZSETBY_NTARGETS || pli->Z_setby > p7_ZSETBY_FILEINFO ||
+      pli->domZ_setby < p7_ZSETBY_NTARGETS || pli->domZ_setby > p7_ZSETBY_FILEINFO)
+    return FALSE;
+  return TRUE;
+}
