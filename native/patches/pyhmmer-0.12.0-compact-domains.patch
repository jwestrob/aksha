+/* Continue one guarded F3 survivor from a sealed set of already-rescored
+ * simple domains.  The compact worker constructs ordinary HMMER domain and
+ * alignment-display objects; the unchanged shared tail owns all hit scoring,
+ * TopHits insertion, and reporting/inclusion behavior. */
+int
+p7_PipelineFromFilterForwardAndCompactDomainsV2(
+    P7_PIPELINE *pli, P7_OPROFILE *om, P7_BG *bg,
+    const ESL_SQ *sq, const ESL_SQ *ntsq, P7_TOPHITS *hitlist,
+    float usc, float filtersc, float vfsc, float fwdsc,
+    uint64_t generation_tail_fingerprint,
+    uint64_t final_target_count,
+    uint32_t expected_row_index, uint32_t expected_profile_index,
+    uint32_t expected_sequence_index, float nexpected,
+    const P7_PIPELINE_COMPACT_DOMAIN *domains, uint64_t domain_count,
+    const uint64_t *trace_offsets, uint64_t trace_offset_count,
+    const P7_PIPELINE_COMPACT_TRACE_STEP *traces, uint64_t trace_count,
+    const float *null2, uint64_t null2_count)
+{
+  float nullsc;
+  float seq_score;
+  double P;
+  int status;
+
+  /* Pipeline/generation/filter validation is read-only.  The domain worker
+   * likewise validates its entire payload and stages all displays before it
+   * mutates reusable domaindef state. */
+  if (pli == NULL || om == NULL || bg == NULL || sq == NULL || hitlist == NULL)
+    return eslEINVAL;
+  if (pli->mode != p7_SEARCH_SEQS || pli->long_targets || ntsq != NULL ||
+      pli->oxf == NULL || pli->oxb == NULL || pli->fwd == NULL ||
+      pli->bck == NULL || pli->ddef == NULL)
+    return eslEINVAL;
+  if (sq->n == 0 || sq->n > 100000 ||
+      ! pipeline_profile_configuration_is_exact(om, sq->n) ||
+      ! pipeline_background_configuration_is_exact(bg, sq->n) ||
+      ! p7_compact_AlphabetSetIsExactV2(
+          om->abc, bg->abc,
+          bg->fhmm == NULL ? NULL : bg->fhmm->abc,
+          sq->abc))
+    return eslEINVAL;
+  if (! pipeline_float_environment_is_exact() ||
+      ! pipeline_compact_tail_options_are_valid(pli) ||
+      ! pipeline_compact_model_cutoffs_are_exact(pli, om) ||
+      generation_tail_fingerprint == 0 ||
+      generation_tail_fingerprint != p7_pipeline_CompactTailFingerprintV2(pli))
+    return eslEINVAL;
+  if (! isfinite(om->evparam[p7_MMU]) ||
+      ! isfinite(om->evparam[p7_MLAMBDA]) || om->evparam[p7_MLAMBDA] <= 0.0f ||
+      ! isfinite(om->evparam[p7_VMU]) ||
+      ! isfinite(om->evparam[p7_VLAMBDA]) || om->evparam[p7_VLAMBDA] <= 0.0f ||
+      ! isfinite(om->evparam[p7_FTAU]) ||
+      ! isfinite(om->evparam[p7_FLAMBDA]) || om->evparam[p7_FLAMBDA] <= 0.0f ||
+      ! isfinite(bg->omega) || bg->omega <= 0.0f || bg->omega >= 1.0f ||
+      ! isfinite(usc) || ! isfinite(fwdsc) ||
+      final_target_count == 0 ||
+      final_target_count > UINT64_C(9007199254740992) ||
+      (pli->Z_setby == p7_ZSETBY_NTARGETS &&
+       (pli->Z < 1.0 || pli->Z > (double) final_target_count ||
+        floor(pli->Z) != pli->Z)) ||
+      ! isfinite(nexpected) || nexpected < 0.0f || nexpected > (float) sq->n ||
+      (pli->do_biasfilter && ! isfinite(filtersc)))
+    return eslEINVAL;
+
+  status = p7_bg_NullOne(bg, sq->dsq, sq->n, &nullsc);
+  if (status != eslOK) return status;
+  seq_score = (usc-nullsc) / eslCONST_LOG2;
+  P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+  if (P > pli->F1) return eslEINVAL;
+  if (pli->do_biasfilter)
+    {
+      seq_score = (usc-filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+      if (P > pli->F1) return eslEINVAL;
+    }
+  else filtersc = nullsc;
+  if (P > pli->F2)
+    {
+      if (isnan(vfsc) || (isinf(vfsc) && vfsc < 0.0f)) return eslEINVAL;
+      seq_score = (vfsc-filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_VMU], om->evparam[p7_VLAMBDA]);
+      if (P > pli->F2) return eslEINVAL;
+    }
+  seq_score = (fwdsc-filtersc) / eslCONST_LOG2;
+  P = esl_exp_surv(seq_score, om->evparam[p7_FTAU], om->evparam[p7_FLAMBDA]);
+  if (P > pli->F3) return eslEINVAL;
+
+  status = p7_domaindef_ByExternalCompactDomainsV2(
+      sq, ntsq, om, pli, bg, pli->ddef, nullsc, fwdsc, nexpected,
+      final_target_count,
+      expected_row_index, expected_profile_index, expected_sequence_index,
+      domains, domain_count, trace_offsets, trace_offset_count,
+      traces, trace_count, null2, null2_count);
+  if (status != eslOK) return status;
+
+  pli->n_past_msv++;
+  pli->n_past_bias++;
+  pli->n_past_vit++;
+  pli->n_past_fwd++;
+  return pipeline_post_domains(pli, om, bg, sq, hitlist, nullsc, fwdsc);
+}
