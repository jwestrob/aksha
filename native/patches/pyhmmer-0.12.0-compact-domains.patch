@@ -1835,0 +1836,195 @@ typedef struct p7_pipeline_simple_region_s {
+/* Compact result of one externally rescored simple domain.  This layout is
+ * deliberately pointer-free and matches plan7_gpu's sealed CUDA journal.
+ * Coordinates are one-based and refer to the complete target sequence. */
+enum p7_pipeline_compact_domain_abi_e {
+  p7_COMPACT_DOMAIN_RECORD_VERSION = 1,
+  p7_COMPACT_DOMAIN_RECORD_SIZE    = 64,
+  p7_COMPACT_TRACE_STEP_SIZE       = 16,
+  p7_COMPACT_NULL2_COUNT           = p7_MAXCODE,
+  p7_COMPACT_DOMAIN_CPU_REQUIRED   = 0,
+  p7_COMPACT_DOMAIN_DEVICE_RESULT  = 1,
+  p7_COMPACT_FINAL_CALL_GUARD_VERSION = 1,
+  p7_COMPACT_FINAL_CALL_FALLBACK   = eslEINACCURATE
+};
+
+/* One accepted compact input may differ from the exact CPU input by this
+ * many nats. The final-call guard propagates this interval through the stock
+ * target/domain score formulas before allowing the compact tail to mutate
+ * pipeline state. This is twice the seam's largest 2e-3 consistency check
+ * and more than 8000x the observed CUDA/CPU score delta. */
+#define p7_COMPACT_FINAL_CALL_INPUT_EPSILON_NATS 0.004f
+#define p7_COMPACT_FINAL_CALL_ROUND_EPSILON_BITS 0.00001f
+
+/* The pressed optimized profile, pipeline background, bias-filter HMM, and
+ * digitized target may own distinct ESL_ALPHABET objects. Pointer identity is
+ * therefore not a compatibility test. Compact continuation instead requires
+ * four independently canonical standard-protein alphabets and compares every
+ * semantic field that can affect digitization, residue lookup, or display.
+ * Object pointers and structure padding are deliberately ignored. */
+static inline int
+p7_compact_AlphabetIsCanonicalAminoV2(const ESL_ALPHABET *abc)
+{
+  static const char symbols[] = "ACDEFGHIKLMNPQRSTVWY-BJZOUX*~";
+  ESL_DSQ expected_code;
+  int expected_degeneracy;
+  int c;
+  int x;
+  int y;
+
+  if (abc == NULL || abc->type != eslAMINO || abc->K != 20 || abc->Kp != 29 ||
+      abc->sym == NULL || abc->degen == NULL || abc->ndegen == NULL ||
+      abc->complement != NULL)
+    return FALSE;
+
+  for (x = 0; x <= abc->Kp; x++)
+    if (abc->sym[x] != symbols[x]) return FALSE;
+
+  for (c = 0; c < 128; c++)
+    {
+      expected_code = eslDSQ_ILLEGAL;
+      for (x = 0; x < abc->Kp; x++)
+        if (c == (unsigned char) symbols[x])
+          { expected_code = (ESL_DSQ) x; break; }
+      if (c >= 'a' && c <= 'z')
+        for (x = 0; x < abc->Kp; x++)
+          if (c - 'a' + 'A' == (unsigned char) symbols[x])
+            { expected_code = (ESL_DSQ) x; break; }
+      if (c == '.' || c == '_') expected_code = 20;
+      if (abc->inmap[c] != expected_code) return FALSE;
+    }
+
+  for (x = 0; x < abc->Kp; x++)
+    {
+      if (abc->degen[x] == NULL) return FALSE;
+      expected_degeneracy = 0;
+      for (y = 0; y < abc->K; y++)
+        {
+          int expected =
+              (x < 20 && x == y) ||
+              (x == 21 && (y == 2 || y == 11)) ||
+              (x == 22 && (y == 7 || y == 9)) ||
+              (x == 23 && (y == 3 || y == 13)) ||
+              (x == 24 && y == 8) ||
+              (x == 25 && y == 1) ||
+              (x == 26);
+          expected_degeneracy += expected;
+          if (abc->degen[x][y] != (char) expected) return FALSE;
+        }
+      if (abc->ndegen[x] != expected_degeneracy) return FALSE;
+    }
+  return TRUE;
+}
+
+static inline int
+p7_compact_AlphabetsAreEqualV2(const ESL_ALPHABET *left,
+                               const ESL_ALPHABET *right)
+{
+  int c;
+  int x;
+  int y;
+
+  if (left == NULL || right == NULL ||
+      left->type != eslAMINO || right->type != eslAMINO ||
+      left->K != 20 || right->K != 20 ||
+      left->Kp != 29 || right->Kp != 29 ||
+      left->type != right->type || left->K != right->K ||
+      left->Kp != right->Kp || left->sym == NULL || right->sym == NULL ||
+      left->degen == NULL || right->degen == NULL ||
+      left->ndegen == NULL || right->ndegen == NULL ||
+      ((left->complement == NULL) != (right->complement == NULL)))
+    return FALSE;
+  for (x = 0; x <= left->Kp; x++)
+    if (left->sym[x] != right->sym[x]) return FALSE;
+  for (c = 0; c < 128; c++)
+    if (left->inmap[c] != right->inmap[c]) return FALSE;
+  for (x = 0; x < left->Kp; x++)
+    {
+      if (left->degen[x] == NULL || right->degen[x] == NULL ||
+          left->ndegen[x] != right->ndegen[x])
+        return FALSE;
+      for (y = 0; y < left->K; y++)
+        if (left->degen[x][y] != right->degen[x][y]) return FALSE;
+      if (left->complement != NULL &&
+          left->complement[x] != right->complement[x])
+        return FALSE;
+    }
+  return TRUE;
+}
+
+static inline int
+p7_compact_AlphabetSetIsExactV2(const ESL_ALPHABET *profile,
+                                const ESL_ALPHABET *background,
+                                const ESL_ALPHABET *filter,
+                                const ESL_ALPHABET *sequence)
+{
+  return p7_compact_AlphabetIsCanonicalAminoV2(profile) &&
+         p7_compact_AlphabetIsCanonicalAminoV2(background) &&
+         p7_compact_AlphabetIsCanonicalAminoV2(filter) &&
+         p7_compact_AlphabetIsCanonicalAminoV2(sequence) &&
+         p7_compact_AlphabetsAreEqualV2(profile, background) &&
+         p7_compact_AlphabetsAreEqualV2(profile, filter) &&
+         p7_compact_AlphabetsAreEqualV2(profile, sequence);
+}
+
+typedef struct p7_pipeline_compact_domain_s {
+  uint32_t row_index;
+  uint32_t profile_index;
+  uint32_t sequence_index;
+  uint32_t envelope_begin;
+  uint32_t envelope_end;
+  uint32_t alignment_begin;
+  uint32_t alignment_end;
+  uint32_t model_begin;
+  uint32_t model_end;
+  float    forward_score;
+  float    backward_score;
+  float    oa_score;
+  float    domain_correction;
+  float    score_consistency;
+  uint8_t  status;
+  uint8_t  action;
+  uint8_t  has_own_scales;
+  uint8_t  reserved;
+  uint32_t reserved2;
+} P7_PIPELINE_COMPACT_DOMAIN;
+
+typedef struct p7_pipeline_compact_trace_step_s {
+  uint32_t sequence_position;
+  uint32_t model_position;
+  float    posterior;
+  uint8_t  state;
+  uint8_t  reserved[3];
+} P7_PIPELINE_COMPACT_TRACE_STEP;
+
+#if defined(__cplusplus)
+static_assert(sizeof(P7_PIPELINE_COMPACT_DOMAIN) == p7_COMPACT_DOMAIN_RECORD_SIZE,
+              "compact domain record ABI changed");
+static_assert(p7_COMPACT_NULL2_COUNT == 29, "compact null2 ABI changed");
+static_assert(sizeof(P7_PIPELINE_COMPACT_TRACE_STEP) == p7_COMPACT_TRACE_STEP_SIZE,
+              "compact trace step ABI changed");
+static_assert(offsetof(P7_PIPELINE_COMPACT_DOMAIN, envelope_begin) == 12 &&
+              offsetof(P7_PIPELINE_COMPACT_DOMAIN, forward_score) == 36 &&
+              offsetof(P7_PIPELINE_COMPACT_DOMAIN, status) == 56 &&
+              offsetof(P7_PIPELINE_COMPACT_DOMAIN, reserved2) == 60,
+              "compact domain field offsets changed");
+static_assert(offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, sequence_position) == 0 &&
+              offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, posterior) == 8 &&
+              offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, state) == 12,
+              "compact trace field offsets changed");
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(sizeof(P7_PIPELINE_COMPACT_DOMAIN) == p7_COMPACT_DOMAIN_RECORD_SIZE,
+               "compact domain record ABI changed");
+_Static_assert(p7_COMPACT_NULL2_COUNT == 29, "compact null2 ABI changed");
+_Static_assert(sizeof(P7_PIPELINE_COMPACT_TRACE_STEP) == p7_COMPACT_TRACE_STEP_SIZE,
+               "compact trace step ABI changed");
+_Static_assert(offsetof(P7_PIPELINE_COMPACT_DOMAIN, envelope_begin) == 12 &&
+               offsetof(P7_PIPELINE_COMPACT_DOMAIN, forward_score) == 36 &&
+               offsetof(P7_PIPELINE_COMPACT_DOMAIN, status) == 56 &&
+               offsetof(P7_PIPELINE_COMPACT_DOMAIN, reserved2) == 60,
+               "compact domain field offsets changed");
+_Static_assert(offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, sequence_position) == 0 &&
+               offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, posterior) == 8 &&
+               offsetof(P7_PIPELINE_COMPACT_TRACE_STEP, state) == 12,
+               "compact trace field offsets changed");
+#endif
+
