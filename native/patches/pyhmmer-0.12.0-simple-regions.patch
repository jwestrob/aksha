+/* Continue domain definition from externally supplied regions that have
+ * already been classified as simple.  This deliberately exposes no posterior
+ * arrays: each interval is rescored by the ordinary Forward/Backward,
+ * posterior-decoding, null2, optimal-accuracy, and display path above. */
+int
+p7_domaindef_ByExternalSimpleRegions(const ESL_SQ *sq, const ESL_SQ *ntsq,
+                                     P7_OPROFILE *om, P7_OMX *fwd,
+                                     P7_OMX *bck, P7_DOMAINDEF *ddef,
+                                     P7_BG *bg, float nexpected,
+                                     const P7_PIPELINE_SIMPLE_REGION *regions,
+                                     uint64_t region_count)
+{
+  int      saveL;
+  int      save_mode;
+  int      status;
+  int      restore_status;
+  uint64_t r;
+
+  /* Trusted internal worker: the public pipeline seam validates generation
+   * provenance and the exact live profile/background configuration first. */
+  if (sq == NULL || ntsq != NULL || om == NULL || fwd == NULL || bck == NULL ||
+      ddef == NULL || bg == NULL || sq->n <= 0 || sq->n > 100000 ||
+      om->L != sq->n || om->mode != p7_LOCAL)
+    return eslEINVAL;
+  if (! isfinite(nexpected) || nexpected < 0.0f ||
+      nexpected > (float) sq->n)
+    return eslEINVAL;
+  if (region_count > (uint64_t) sq->n) return eslEINVAL;
+  if (region_count != 0 && regions == NULL) return eslEINVAL;
+  if (ddef->dcl == NULL || ddef->ndom != 0 || ddef->nregions != 0 ||
+      ddef->nclustered != 0 || ddef->noverlaps != 0 ||
+      ddef->nenvelopes != 0)
+    return eslEINVAL;
+  for (r = 0; r < region_count; r++)
+    {
+      if (regions[r].i == 0 || regions[r].i > regions[r].j ||
+          regions[r].j > (uint32_t) sq->n)
+        return eslEINVAL;
+      if (r != 0 && regions[r].i <= regions[r-1].j) return eslEINVAL;
+    }
+
+  status = p7_domaindef_GrowTo(ddef, sq->n);
+  if (status != eslOK) return status;
+  esl_vec_FSet(ddef->n2sc, sq->n+1, 0.0f);
+  ddef->L          = sq->n;
+  ddef->nexpected  = nexpected;
+  ddef->nregions   = 0;
+  ddef->nclustered = 0;
+  ddef->noverlaps  = 0;
+  ddef->nenvelopes = 0;
+
+  saveL     = om->L;
+  save_mode = om->mode;
+  status = p7_oprofile_ReconfigUnihit(om, saveL);
+  if (status != eslOK) return status;
+
+  for (r = 0; r < region_count; r++)
+    {
+      int i = (int) regions[r].i;
+      int j = (int) regions[r].j;
+      int L = j-i+1;
+
+      status = p7_omx_GrowTo(fwd, om->M, L, L);
+      if (status != eslOK) goto RESTORE;
+      status = p7_omx_GrowTo(bck, om->M, L, L);
+      if (status != eslOK) goto RESTORE;
+      ddef->nregions++;
+      ddef->nenvelopes++;
+      (void) rescore_isolated_domain(ddef, om, sq, ntsq, fwd, bck,
+                                     i, j, FALSE, bg, FALSE,
+                                     NULL, NULL, NULL);
+    }
+
+  status = eslOK;
+
+ RESTORE:
+  if (p7_IsMulti(save_mode))
+    restore_status = p7_oprofile_ReconfigMultihit(om, saveL);
+  else
+    restore_status = p7_oprofile_ReconfigUnihit(om, saveL);
+  if (status == eslOK) status = restore_status;
+  return status;
+}
