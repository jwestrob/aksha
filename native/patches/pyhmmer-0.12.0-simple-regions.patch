+/* Continue an F3 survivor from a guarded external domain route.  This seam is
+ * intentionally protein/search-mode only.  It accepts either no regions or a
+ * sorted set of nonoverlapping simple regions; clustered and uncertain rows
+ * must use p7_PipelineFromFilterAndForwardScores instead. */
+int
+p7_PipelineFromFilterAndForwardSimpleRegions(
+    P7_PIPELINE *pli, P7_OPROFILE *om, P7_BG *bg,
+    const ESL_SQ *sq, const ESL_SQ *ntsq, P7_TOPHITS *hitlist,
+    float usc, float filtersc, float vfsc, float fwdsc,
+    uint64_t generation_f1_bits, uint64_t generation_f2_bits,
+    uint64_t generation_f3_bits, int generation_bias_filter,
+    enum p7_pipeline_domain_route_e route, float nexpected,
+    const P7_PIPELINE_SIMPLE_REGION *regions, uint64_t region_count)
+{
+  union { double value; uint64_t bits; } live;
+  float  nullsc;
+  float  seq_score;
+  double P;
+  int    status;
+  uint64_t r;
+
+  /* Complete validation precedes all pipeline, profile, matrix, domaindef,
+   * counter, and hit-list mutation. */
+  if (pli == NULL || om == NULL || bg == NULL || sq == NULL || hitlist == NULL)
+    return eslEINVAL;
+  if (pli->mode != p7_SEARCH_SEQS || pli->long_targets || ntsq != NULL)
+    return eslEINVAL;
+  if (sq->n == 0 || sq->n > 100000 ||
+      ! pipeline_profile_configuration_is_exact(om, sq->n) ||
+      ! pipeline_background_configuration_is_exact(bg, sq->n))
+    return eslEINVAL;
+  if (! pipeline_float_environment_is_exact()) return eslEINVAL;
+  if (! isfinite(pli->F1) || pli->F1 < 0.0 || pli->F1 > 1.0 ||
+      ! isfinite(pli->F2) || pli->F2 < 0.0 || pli->F2 > 1.0 ||
+      ! isfinite(pli->F3) || pli->F3 < 0.0 || pli->F3 > 1.0 ||
+      ! isfinite(om->evparam[p7_MMU]) ||
+      ! isfinite(om->evparam[p7_MLAMBDA]) || om->evparam[p7_MLAMBDA] <= 0.0f ||
+      ! isfinite(om->evparam[p7_VMU]) ||
+      ! isfinite(om->evparam[p7_VLAMBDA]) || om->evparam[p7_VLAMBDA] <= 0.0f ||
+      ! isfinite(om->evparam[p7_FTAU]) ||
+      ! isfinite(om->evparam[p7_FLAMBDA]) || om->evparam[p7_FLAMBDA] <= 0.0f ||
+      ! isfinite(bg->omega) || bg->omega <= 0.0f || bg->omega >= 1.0f)
+    return eslEINVAL;
+  if (! isfinite(usc) || ! isfinite(fwdsc) ||
+      ! isfinite(nexpected) || nexpected < 0.0f || nexpected > (float) sq->n)
+    return eslEINVAL;
+  if (generation_bias_filter != FALSE && generation_bias_filter != TRUE)
+    return eslEINVAL;
+  if (pli->do_biasfilter && ! isfinite(filtersc)) return eslEINVAL;
+
+  live.value = pli->F1; if (live.bits != generation_f1_bits) return eslEINVAL;
+  live.value = pli->F2; if (live.bits != generation_f2_bits) return eslEINVAL;
+  live.value = pli->F3; if (live.bits != generation_f3_bits) return eslEINVAL;
+  if (pli->do_biasfilter != generation_bias_filter) return eslEINVAL;
+
+  if (route == p7_DOMAIN_NO_REGIONS)
+    {
+      if (region_count != 0 || regions != NULL) return eslEINVAL;
+    }
+  else if (route == p7_DOMAIN_SIMPLE)
+    {
+      if (region_count == 0 || region_count > (uint64_t) sq->n ||
+          regions == NULL)
+        return eslEINVAL;
+    }
+  else return eslEINVAL;
+
+  for (r = 0; r < region_count; r++)
+    {
+      if (regions[r].i == 0 || regions[r].i > regions[r].j ||
+          regions[r].j > (uint32_t) sq->n)
+        return eslEINVAL;
+      if (r != 0 && regions[r].i <= regions[r-1].j) return eslEINVAL;
+    }
+  if (pli->fwd == NULL || pli->bck == NULL ||
+      pli->ddef == NULL || pli->ddef->dcl == NULL ||
+      pli->ddef->ndom != 0 || pli->ddef->nregions != 0 ||
+      pli->ddef->nclustered != 0 || pli->ddef->noverlaps != 0 ||
+      pli->ddef->nenvelopes != 0)
+    return eslEINVAL;
+
+  status = p7_bg_NullOne(bg, sq->dsq, sq->n, &nullsc);
+  if (status != eslOK) return status;
+  seq_score = (usc-nullsc) / eslCONST_LOG2;
+  P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+  if (P > pli->F1) return eslEINVAL;
+  if (pli->do_biasfilter)
+    {
+      seq_score = (usc-filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+      if (P > pli->F1) return eslEINVAL;
+    }
+  else filtersc = nullsc;
+  if (P > pli->F2)
+    {
+      if (isnan(vfsc) || (isinf(vfsc) && vfsc < 0.0f)) return eslEINVAL;
+      seq_score = (vfsc-filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_VMU], om->evparam[p7_VLAMBDA]);
+      if (P > pli->F2) return eslEINVAL;
+    }
+  seq_score = (fwdsc-filtersc) / eslCONST_LOG2;
+  P = esl_exp_surv(seq_score, om->evparam[p7_FTAU], om->evparam[p7_FLAMBDA]);
+  if (P > pli->F3) return eslEINVAL;
+
+  pli->n_past_msv++;
+  pli->n_past_bias++;
+  pli->n_past_vit++;
+  pli->n_past_fwd++;
+  if (route == p7_DOMAIN_NO_REGIONS)
+    {
+      pli->ddef->L = sq->n;
+      pli->ddef->nexpected = nexpected;
+      return eslOK;
+    }
+  status = p7_domaindef_ByExternalSimpleRegions(
+      sq, ntsq, om, pli->fwd, pli->bck, pli->ddef, bg,
+      nexpected, regions, region_count);
+  if (status != eslOK)
+    ESL_FAIL(status, pli->errbuf, "external simple-region workflow failure");
+  return pipeline_post_domains(pli, om, bg, sq, hitlist, nullsc, fwdsc);
+}
+
+/* A normal protein comparison enters the post-Forward workflow with the
+ * optimized profile in multihit-local mode and fully reconfigured for the
+ * current target length.  om->mode and om->L alone are insufficient:
+ * ReconfigUnihit() deliberately changes nj/xf without changing mode. */
+static int
+pipeline_profile_configuration_is_exact(const P7_OPROFILE *om, int L)
+{
+  union { float value; uint32_t bits; } expected, live;
+  float pmove;
+  float ploop;
+  int x;
+
+  if (om == NULL || L <= 0 || om->mode != p7_LOCAL || om->L != L)
+    return FALSE;
+  expected.value = 1.0f; live.value = om->nj;
+  if (expected.bits != live.bits) return FALSE;
+  expected.value = 0.5f; live.value = om->xf[p7O_E][p7O_MOVE];
+  if (expected.bits != live.bits) return FALSE;
+  live.value = om->xf[p7O_E][p7O_LOOP];
+  if (expected.bits != live.bits) return FALSE;
+
+  pmove = 3.0f / ((float) L + 3.0f);
+  ploop = 1.0f - pmove;
+  for (x = p7O_N; x <= p7O_C; x++)
+    {
+      expected.value = pmove; live.value = om->xf[x][p7O_MOVE];
+      if (expected.bits != live.bits) return FALSE;
+      expected.value = ploop; live.value = om->xf[x][p7O_LOOP];
+      if (expected.bits != live.bits) return FALSE;
+    }
+  return TRUE;
+}
+
+/* Null1 uses bg->p1, while the filter HMM caches the same length model.
+ * Require the exact state produced by p7_bg_SetLength(bg, L). */
+static int
+pipeline_background_configuration_is_exact(const P7_BG *bg, int L)
+{
+  union { float value; uint32_t bits; } expected, live;
+
+  if (bg == NULL || bg->fhmm == NULL || bg->fhmm->t == NULL ||
+      bg->fhmm->t[0] == NULL || L <= 0)
+    return FALSE;
+  expected.value = (float) L / (float) (L + 1);
+  live.value = bg->p1;
+  if (expected.bits != live.bits) return FALSE;
+  live.value = bg->fhmm->t[0][0];
+  if (expected.bits != live.bits) return FALSE;
+  expected.value = 1.0f - expected.value;
+  live.value = bg->fhmm->t[0][1];
+  return expected.bits == live.bits;
+}
