+static int
+pipeline_validate_backward_specials(
+    const P7_OPROFILE *om, const ESL_SQ *sq,
+    const float *forward_xmx, const float *backward_xmx,
+    uint64_t backward_xmx_count, float backward_score,
+    float backward_totscale, int backward_has_own_scales)
+{
+  union { float value; uint32_t bits; } expected, supplied;
+  const uint64_t expected_count =
+      ((uint64_t) sq->n + 1) * p7X_NXCELLS;
+  float scale;
+  float xC;
+  float xE;
+  float reconstructed;
+  int i;
+  int s;
+
+  if (forward_xmx == NULL || backward_xmx == NULL ||
+      backward_xmx_count != expected_count ||
+      (backward_has_own_scales != FALSE &&
+       backward_has_own_scales != TRUE) ||
+      ! isfinite(backward_score) || ! isfinite(backward_totscale) ||
+      backward_totscale < 0.0f)
+    return eslEINVAL;
+  for (i = 0; i <= sq->n; i++)
+    {
+      for (s = 0; s < p7X_NXCELLS; s++)
+        if (! isfinite(backward_xmx[i*p7X_NXCELLS+s]) ||
+            backward_xmx[i*p7X_NXCELLS+s] < 0.0f)
+          return eslEINVAL;
+      scale = backward_xmx[i*p7X_NXCELLS+p7X_SCALE];
+      if (scale != 1.0f && scale <= 1.0e4f) return eslEINVAL;
+      if (! backward_has_own_scales)
+        {
+          expected.value = forward_xmx[i*p7X_NXCELLS+p7X_SCALE];
+          supplied.value = scale;
+          if (expected.bits != supplied.bits) return eslEINVAL;
+        }
+    }
+
+  expected.value = 0.0f;
+  supplied.value = backward_xmx[p7X_E];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  supplied.value = backward_xmx[p7X_J];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  supplied.value = backward_xmx[p7X_C];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 1.0f;
+  supplied.value = backward_xmx[p7X_SCALE];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  if (backward_xmx[p7X_N] <= 0.0f) return eslEINVAL;
+
+  scale = forward_xmx[sq->n*p7X_NXCELLS+p7X_SCALE];
+  xC = om->xf[p7O_C][p7O_MOVE];
+  xE = xC * om->xf[p7O_E][p7O_MOVE];
+  if (scale > 1.0f)
+    {
+      xC /= scale;
+      xE /= scale;
+    }
+  expected.value = xE;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_E];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 0.0f;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_N];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_J];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_B];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = xC;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_C];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = scale;
+  supplied.value = backward_xmx[sq->n*p7X_NXCELLS+p7X_SCALE];
+  if (expected.bits != supplied.bits) return eslEINVAL;
+
+  reconstructed = backward_totscale + log(backward_xmx[p7X_N]);
+  expected.value = reconstructed;
+  supplied.value = backward_score;
+  return expected.bits == supplied.bits ? eslOK : eslEINVAL;
