+  seq_score = (usc - nullsc) / eslCONST_LOG2;
+  P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+  if (P > pli->F1) return eslOK;
+
+  return pipeline_post_msv(pli, om, bg, sq, ntsq, hitlist, usc, nullsc, P, TRUE, filtersc, vitmode, vfsc,
+                           FALSE, 0.0f, NULL, 0.0f);
+}
+
+/* Continue from exact external filter and Forward scores. The F1, bias, F2,
+ * and F3 gates are all replayed here. A row that fails any gate needs no
+ * Forward matrix. A row that passes F3 must supply the complete parsing-mode
+ * special-state matrix, including the scale cell for every row. */
+int
+p7_PipelineFromFilterAndForwardScores(P7_PIPELINE *pli, P7_OPROFILE *om, P7_BG *bg,
+                                      const ESL_SQ *sq, const ESL_SQ *ntsq, P7_TOPHITS *hitlist,
+                                      float usc, float filtersc, float vfsc, float fwdsc,
+                                      const float *xmx, uint64_t xmx_count)
+{
+  float  forward_totscale = 0.0f;
+  float  nullsc;
+  float  seq_score;
+  double P;
+  double initial_P;
+  int    status;
+
+  if (pli->mode != p7_SEARCH_SEQS) return eslEINVAL;
+  if (sq->n == 0) return eslOK;
+  if (sq->n > 100000) ESL_EXCEPTION(eslETYPE, "Target sequence length > 100K, over comparison pipeline limit.\n(Did you mean to use nhmmer/nhmmscan?)");
+  if (! pipeline_float_environment_is_exact()) return eslEINVAL;
+  if (! isfinite(usc) || ! isfinite(fwdsc)) return eslEINVAL;
+  if (pli->do_biasfilter && ! isfinite(filtersc)) return eslEINVAL;
+
+  p7_bg_NullOne(bg, sq->dsq, sq->n, &nullsc);
+  seq_score = (usc - nullsc) / eslCONST_LOG2;
+  P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+  if (P > pli->F1) return eslOK;
+  initial_P = P;
+
+  if (pli->do_biasfilter)
+    {
+      seq_score = (usc - filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_MMU], om->evparam[p7_MLAMBDA]);
+      if (P > pli->F1) return eslOK;
+    }
+  else filtersc = nullsc;
+
+  if (P > pli->F2)
+    {
+      if (isnan(vfsc) || (isinf(vfsc) && vfsc < 0.0f)) return eslEINVAL;
+      seq_score = (vfsc - filtersc) / eslCONST_LOG2;
+      P = esl_gumbel_surv(seq_score, om->evparam[p7_VMU], om->evparam[p7_VLAMBDA]);
+      if (P > pli->F2) return eslOK;
+    }
+
+  seq_score = (fwdsc - filtersc) / eslCONST_LOG2;
+  P = esl_exp_surv(seq_score, om->evparam[p7_FTAU], om->evparam[p7_FLAMBDA]);
+  if (P > pli->F3)
+    return pipeline_post_msv(pli, om, bg, sq, ntsq, hitlist, usc, nullsc, initial_P,
+                             TRUE, filtersc, p7_VIT_EXTERNAL, vfsc,
+                             TRUE, fwdsc, NULL, 0.0f);
+
+  status = pipeline_validate_forward_specials(om, sq, fwdsc, xmx, xmx_count, &forward_totscale);
+  if (status != eslOK) return status;
+
+  return pipeline_post_msv(pli, om, bg, sq, ntsq, hitlist, usc, nullsc, initial_P,
+                           TRUE, filtersc, p7_VIT_EXTERNAL, vfsc,
+                           TRUE, fwdsc, xmx, forward_totscale);
+}
+
+static int
+pipeline_float_environment_is_exact(void)
+{
+#if defined(__x86_64__) && defined(__GLIBC__)
+  const unsigned int rounding_ftz_daz_mask = 0x0000e040u;
+  return fegetround() == FE_TONEAREST && (_mm_getcsr() & rounding_ftz_daz_mask) == 0;
+#else
+  return FALSE;
+#endif
+}
+
+static int
+pipeline_validate_forward_specials(const P7_OPROFILE *om, const ESL_SQ *sq, float fwdsc,
+                                   const float *xmx, uint64_t xmx_count, float *ret_totscale)
+{
+  union { float value; uint32_t bits; } expected, supplied;
+  uint64_t expected_count = ((uint64_t) sq->n + 1) * p7X_NXCELLS;
+  float    xB;
+  float    xC;
+  float    xE;
+  float    xJ;
+  float    xN;
+  float    scale;
+  float    terminal;
+  float    totscale = 0.0f;
+  int      i;
+  int      s;
+
+  if (xmx == NULL || ret_totscale == NULL || xmx_count != expected_count) return eslEINVAL;
+  expected.value = 0.0f; supplied.value = xmx[p7X_E];     if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 1.0f; supplied.value = xmx[p7X_N];     if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 0.0f; supplied.value = xmx[p7X_J];     if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = om->xf[p7O_N][p7O_MOVE];
+                         supplied.value = xmx[p7X_B];     if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 0.0f; supplied.value = xmx[p7X_C];     if (expected.bits != supplied.bits) return eslEINVAL;
+  expected.value = 1.0f; supplied.value = xmx[p7X_SCALE]; if (expected.bits != supplied.bits) return eslEINVAL;
+
+  xN = xmx[p7X_N];
+  xJ = xmx[p7X_J];
+  xC = xmx[p7X_C];
+
+  for (i = 0; i <= sq->n; i++)
+    {
+      for (s = 0; s < p7X_NXCELLS; s++)
+        if (! isfinite(xmx[i*p7X_NXCELLS+s]) || xmx[i*p7X_NXCELLS+s] < 0.0f) return eslEINVAL;
+      scale = xmx[i*p7X_NXCELLS+p7X_SCALE];
+      if (scale != 1.0f && scale <= 1.0e4f) return eslEINVAL;
+      if (i == 0) continue;
+
+      xE = xmx[i*p7X_NXCELLS+p7X_E];
+      if (scale > 1.0f)
+        {
+          expected.value = 1.0f;
+          supplied.value = xE;
+          if (expected.bits != supplied.bits) return eslEINVAL;
+          xE = scale;
+        }
+      else if (xE > 1.0e4f) return eslEINVAL;
+
+      xN = xN * om->xf[p7O_N][p7O_LOOP];
+      xC = (xC * om->xf[p7O_C][p7O_LOOP]) + (xE * om->xf[p7O_E][p7O_MOVE]);
+      xJ = (xJ * om->xf[p7O_J][p7O_LOOP]) + (xE * om->xf[p7O_E][p7O_LOOP]);
+      xB = (xJ * om->xf[p7O_J][p7O_MOVE]) + (xN * om->xf[p7O_N][p7O_MOVE]);
+      if (scale > 1.0f)
+        {
+          xN /= scale;
+          xC /= scale;
+          xJ /= scale;
+          xB /= scale;
+          totscale += log(scale);
+        }
+
+      expected.value = xN; supplied.value = xmx[i*p7X_NXCELLS+p7X_N]; if (expected.bits != supplied.bits) return eslEINVAL;
+      expected.value = xJ; supplied.value = xmx[i*p7X_NXCELLS+p7X_J]; if (expected.bits != supplied.bits) return eslEINVAL;
+      expected.value = xB; supplied.value = xmx[i*p7X_NXCELLS+p7X_B]; if (expected.bits != supplied.bits) return eslEINVAL;
+      expected.value = xC; supplied.value = xmx[i*p7X_NXCELLS+p7X_C]; if (expected.bits != supplied.bits) return eslEINVAL;
+    }
+
+  terminal = xmx[sq->n*p7X_NXCELLS+p7X_C] * om->xf[p7O_C][p7O_MOVE];
+  if (! isfinite(terminal) || terminal <= 0.0f) return eslEINVAL;
+  expected.value = totscale + log(terminal);
+  supplied.value = fwdsc;
+  if (expected.bits != supplied.bits) return eslEINVAL;
+
+  *ret_totscale = totscale;
+  return eslOK;
+}
